# Cargo build products
target/

# MSVC build products for the C reference harnesses
*.obj
*.exe
*.lib
*.dll
*.pdb
*.ilk
porttest/*.obj
porttest/*.exe
porttest/msvc_shim/*.obj

# Copies of the C libraries, taken from the rebound/reboundx source trees
porttest/librebound.*
porttest/libreboundx.*

# Verification dumps and run logs. Every one of these is regenerated by the
# commands in README.md and reboundx_port_test.md; none is an input to
# anything. The
# stderr logs in particular reach hundreds of megabytes, because REBOUNDx
# prints a velocity-dependent-force warning on every single timestep.
*.log
porttest/state_*.txt
porttest/readback_*.txt
porttest/*.bin
logs/

# MSVC linker export files. Build products, and they embed the
# absolute build path (and therefore the local username) in plain
# text - never publish them.
*.exp
porttest/*.exp
